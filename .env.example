# Copy to .env and edit. .env is gitignored.
# Port the dashboard listens on.
PORT=8420
# Address the server listens on. 127.0.0.1 keeps it on this machine; 0.0.0.0 opens it to your
# network, and there is no login.
HOST=127.0.0.1
# Comma-separated hostnames /api answers to besides localhost, 127.0.0.1 and [::1]: the name or
# address you browse to from another device. Any other Host header gets 403.
ALLOWED_HOSTS=
# Directory holding plan.json, rules.json, secrets.json and the sqlite database. Gitignored.
DATA_DIR=./data
# Minutes between automatic bank syncs. 0 disables automatic sync (manual only).
SYNC_INTERVAL_MINUTES=60
