!data/*.example.json
.env
.env.*
!.env.example
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.csv
*.ofx
*.qfx
*.xlsx

# build / deps
node_modules/
dist/
coverage/
*.log
.DS_Store

# local agent workflow state
.devloop/
