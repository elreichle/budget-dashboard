{
  "name": "budget-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted personal budget dashboard: bank sync, monthly buckets, debt payoff and savings goals on a local port.",
  "engines": { "node": ">=22.9" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . && node scripts/pii-guard.mjs",
    "pii-guard": "node scripts/pii-guard.mjs",
    "pii-guard:history": "node scripts/pii-guard.mjs --history",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.30.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
